# Optional configuration. Copy to .env at the repository root.
# Predictions run locally; no database is needed for the demo.
API_URL=http://127.0.0.1:8000/predict
MODEL_DIR=.models
INFERENCE_BACKEND=public
# Sentiment artifacts use MODEL_DIR/sentiment (a separate newly added task).
# Optional official YouTube retrieval. Keep your key local; never commit it.
# YOUTUBE_API_KEY=
# Set INFERENCE_BACKEND=shared_bert after training to load ARTIFACT_DIR/civicbalance.

# Optional training: supply licensed public datasets with all required labels.
# Jigsaw 2018 six-label CSV, NOT the single-label multilingual competition.
JIGSAW_TRAIN_CSV=MainFolder/data/jigsaw_train.csv
# GoEmotions CSV containing text and the six binary positive-emotion columns.
GOEMOTIONS_CSV=MainFolder/data/goemotions.csv
ARTIFACT_DIR=MainFolder/artifacts

# Optional SQL exploration. Set your own local credentials; never commit them.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civicbalance
